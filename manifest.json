{
  "manifest_version": 3,
  "name": "优选AI",
  "version": "0.2.1",
  "description": "一个输入框同时问 Claude / ChatGPT / Gemini 网页版，并排对比回答，可让其中一个 AI 当裁判总结差异。",
  "permissions": ["tabs", "tabGroups", "storage"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "优选AI：打开对比页" },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*"
      ],
      "js": ["sites.js", "lib/sanitize.js", "content/runner.js"],
      "run_at": "document_idle"
    }
  ]
}
